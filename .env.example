POSTGRES_DB=hotel_system
POSTGRES_USER=hotel_system_user
POSTGRES_PASSWORD=hotel_system_password
POSTGRES_PORT=5433

# =====================================================
# Application Users
# =====================================================
# Note: These should be changed in production
APP_USER=ariel5253
APP_PASSWORD=ariel5253
APP_READONLY_USER=app_readonly
APP_READONLY_PASSWORD=app_readonly_default_password

# =====================================================
# Bootstrap Admin
# =====================================================
# Note: Change this password immediately in production
BOOTSTRAP_ADMIN_PASSWORD=bootstrap_admin_init_password

# =====================================================
# Liquibase Configuration
# =====================================================
LIQUIBASE_CHANGELOG_FILE=changelog-master.yaml
LIQUIBASE_CLASSPATH=/liquibase/liquibase_libs/postgresql-42.7.8.jar

# =====================================================
# Optional: Timeouts and Limits
# =====================================================
DB_CONNECTION_TIMEOUT=30
DB_MAX_POOL_SIZE=20
DB_IDLE_TIMEOUT=60000

# =====================================================
# Optional: Logging Configuration
# =====================================================
LOG_LEVEL=INFO
POSTGRES_LOG_LEVEL=notice

